      "role": "healer",
      "content": "raid",
      "tier": "primary",
      "summary": "The standard Classic raid priest: Spiritual Healing (+10% healing), Spiritual Guidance (Spirit to healing), Holy Specialization + Inspiration for tank mitigation, Divine Fury for Greater Heal cast time, plus Divine Spirit, Inner Focus, Meditation and Mental Agility from Discipline.",
      "allocation": {
        "Discipline": [["Unbreakable Will", 5], ["Improved Power Word: Fortitude", 2], ["Silent Resolve", 4], ["Inner Focus", 1], ["Meditation", 3], ["Mental Agility", 5], ["Divine Spirit", 1]],
        "Holy": [["Healing Focus", 2], ["Improved Renew", 2], ["Holy Specialization", 5], ["Divine Fury", 5], ["Inspiration", 3], ["Improved Healing", 3], ["Spiritual Guidance", 5], ["Spiritual Healing", 5]],
        "Shadow": []
      },
      "core": [
        {"talent": "Spiritual Healing", "why": "+10% to all healing."},
        {"talent": "Spiritual Guidance", "why": "25% of Spirit becomes healing power — Spirit is your best stat."},
        {"talent": "Divine Spirit", "why": "+40 Spirit raid buff (one priest per raid must have it)."},
        {"talent": "Inspiration", "why": "+25% armor on the target after a crit heal — tank mitigation."},
        {"talent": "Holy Specialization", "why": "+5% Holy crit feeds Inspiration."},
        {"talent": "Divine Fury", "why": "-0.5s on Greater Heal/Heal/Smite/Holy Fire."},
        {"talent": "Improved Healing", "why": "-15% mana on Heal/Greater Heal."},
        {"talent": "Meditation", "why": "+15% mana regen while casting."},
        {"talent": "Inner Focus", "why": "Free +25% crit spell every 3 minutes."},
        {"talent": "Healing Focus", "why": "70% pushback resistance — mandatory on any fight with raid damage."},
        {"talent": "Mental Agility", "why": "-10% mana on instants (Renew, Shield, Fade)."},
        {"talent": "Improved Power Word: Fortitude", "why": "+30% Fortitude for the raid."}
      ],
      "flex": [
        {"points": 5, "default": "Unbreakable Will", "alternatives": ["Wand Specialization"], "why": "Tier-1 Discipline filler; Unbreakable Will helps if you get feared/stunned."},
        {"points": 4, "default": "Silent Resolve", "alternatives": ["Improved Power Word: Shield 3 + Silent Resolve 1", "Martyrdom"], "why": "Threat reduction is nice; Improved Shield is better if you shield a lot."},
        {"points": 2, "default": "Improved Renew", "alternatives": ["Spirit of Redemption 1 + Improved Renew 1", "Improved Prayer of Healing (by dropping Healing Focus)"], "why": "Improved Renew 3/3 vs. Spirit of Redemption is personal preference."}
      ],
      "notes": [
        "Greater Heal on tanks, Flash Heal/Renew on the raid; use Inner Focus with Greater Heal or Prayer of Healing.",
        "Improved Prayer of Healing (2) is worth taking on heavy raid-damage fights by dropping Healing Focus."
      ],
      "sources": [
        "https://www.icy-veins.com/wow-classic/priest-healer-pve-spec-builds-talents",
        "https://www.wowhead.com/classic/guide/classes/priest/healer-talent-builds-pve"
      ]
    },
