          ["Healing Grace", 2],
          ["Restorative Totems", 5],
          ["Tidal Mastery", 5],
          ["Healing Way", 3],
          ["Nature's Swiftness", 1],
          ["Purification", 5],
          ["Mana Tide Totem", 1]
