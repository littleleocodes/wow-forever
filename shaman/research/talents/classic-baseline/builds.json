      "core": [
        {"talent": "Purification", "why": "+10% healing."},
        {"talent": "Mana Tide Totem", "why": "Group mana every 5 minutes."},
        {"talent": "Nature's Swiftness", "why": "Instant Healing Wave / Chain Heal every 3 minutes."},
        {"talent": "Tidal Mastery", "why": "+5% healing crit (feeds Ancestral Healing)."},
        {"talent": "Improved Healing Wave", "why": "-0.5s Healing Wave cast."},
