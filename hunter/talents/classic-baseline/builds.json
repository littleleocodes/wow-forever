        {"talent": "Ferocity", "why": "+10% pet crit."},
        {"talent": "Improved Hunter's Mark", "why": "+attack power on the target for all physical DPS; only one hunter per raid needs it."},
        {"talent": "Hawk Eye", "why": "+6 yards range — safer positioning."},
        {"talent": "Barrage", "why": "+15% Multi-Shot/Volley; prerequisite for Trueshot Aura."}
      ],
      "flex": [
        {
          "points": 5,
          "default": "Endurance Training 3 + Improved Revive Pet 2",
          "alternatives": ["Endurance Training 5", "Improved Aspect of the Monkey", "Bestial Swiftness"],
          "why": "Filler to reach Unleashed Fury; pet-death frequency decides between health and revive time."
        },
        {
          "points": 3,
          "default": "Improved Hunter's Mark",
          "alternatives": ["Scatter Shot 1 + Improved Arcane Shot 2", "Improved Concussive Shot"],
          "why": "If another hunter has Improved Hunter's Mark, take Scatter Shot for PvP/utility instead."
